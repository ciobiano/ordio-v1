{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:scrap": "node scripts/test-scrap-analyzer.js",
    "test:complexity": "npx complexity-report --threshold 10",
    "test:circular": "madge --circular --extensions ts,tsx src/stores src/components src/lib src/hooks",
    "test:acceptance": "vitest run src/__tests__/features"
  },
  "dependencies": {
    "@Ordio/convex": "workspace:*",
    "@Ordio/engine": "workspace:*",
    "@Ordio/shared": "workspace:*",
    "@base-ui/react": "^1.3.0",
    "@clerk/nextjs": "^7.0.4",
    "@ffmpeg/core-st": "^0.11.1",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/react": "^1.1.6",
    "@ricky0123/vad-web": "^0.0.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.17.0",
    "copy-webpack-plugin": "^12.0.2",
    "framer-motion": "^12.36.0",
    "griddy-icons": "^0.2.0",
    "next": "15.5.12",
    "next-themes": "^0.4.6",
    "onnxruntime-web": "^1.24.2",
    "openai": "^6.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.22.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.58.2",
    "@pythonidaer/complexity-report": "^1.0.18",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^8",
    "eslint-config-next": "15.3.3",
    "jsdom": "^28.1.0",
    "madge": "^8.0.0",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
