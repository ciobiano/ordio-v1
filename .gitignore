*.pid
*.seed
*.pid.lock

# ── Certificates ─────────────────────────────────────────────
*.pem
*.key
*.crt

# ── Archives & binaries (prevent accidental commits) ─────────
*.zip
*.tar.gz
*.rar
*.7z
*.wasm
!apps/web/public/**/*.wasm
.gstack/

