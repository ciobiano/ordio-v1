# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnpm-debug.log*
.pnpm-store/

# ── Build outputs ────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo

# ── Assets copied by webpack during build ───────────────────
apps/web/public/vad/
apps/web/public/ffmpeg/

# ── Generated code ───────────────────────────────────────────
# _generated/ is committed so CI has types without needing a live Convex deployment.
# Regenerate locally with: npx convex dev (then commit the updated _generated/)

# ── Environment / secrets ────────────────────────────────────
# NEVER commit .env files — use .env.example for documentation
.env
.env.*
!.env.example

# ── Test output ──────────────────────────────────────────────
coverage/
playwright-report/
test-results/
.playwright/
*.lcov

# ── Turborepo ────────────────────────────────────────────────
.turbo/

# ── AI tool project data ─────────────────────────────────────
.claude/
.superpowers/
CLAUDE.md
AGENTS.md

# ── Planning / non-essential docs ────────────────────────────
tasks/
agent_docs/
workflow.md
venv/

# ── Reference / brand materials ──────────────────────────────
Apple-HIGs/
apps/**/*.pdf
**/__pycache__/
*.pyc

# ── Personal / workflow files ────────────────────────────────
note.md
TODO.md
scratch.*

# ── IDEs & editors ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS generated ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

