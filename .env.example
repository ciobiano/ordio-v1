# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk JWT issuer — set in the CONVEX dashboard, not here. Convex validates
# every identity against this issuer; if it is unset or wrong, every
# authenticated query silently returns empty rather than erroring.
CLERK_JWT_ISSUER_DOMAIN=https://<subdomain>.clerk.accounts.dev

# Convex
NEXT_PUBLIC_CONVEX_URL=https://<project>.convex.cloud

# Canonical site origin. Used for sitemap/robots/OG metadata, and as the
# fallback return origin for checkout when a request carries no Origin header.
NEXT_PUBLIC_SITE_URL=https://ordio.app

# Modal GPU audio-enhancement service. Optional: if unset, enhancement
# degrades gracefully to 'none' with a toast rather than failing the pipeline.
NEXT_PUBLIC_ENHANCE_URL=https://<workspace>--ordio-enhance.modal.run

# OpenAI (Whisper transcription)
OPENAI_API_KEY=sk-...

# Phase C — Stripe (international payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_CREATOR_PRICE_ID=price_...

# Phase C — Paystack (Nigerian payments)
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_CREATOR_PLAN_CODE=PLN_...

# Phase C — Convex dashboard env vars (set in dashboard, not .env.local)
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYSTACK_SECRET_KEY=sk_test_...
